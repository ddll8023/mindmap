{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "types": ["react", "react-dom"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/components/MindMap"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
